# Internal integration token from https://www.notion.so/profile/integrations
# The token stays in Netlify. It is never sent to the browser.
NOTION_TOKEN=

# Password you type to open Life OS. Change it here, then redeploy.
APP_PASSWORD=

# Optional. When unset, the session cookie is signed with a key derived from APP_PASSWORD.
# SESSION_SECRET=

# Optional. Leave blank to auto-discover the four databases.
# NOTION_TASKS_DB=
# NOTION_HABITS_DB=
# NOTION_JOURNAL_DB=
# NOTION_WEEKLY_DB=
